# Supabase public client (publishable key only)
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key

# Server only: never prefix this key with NUXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-secret-key

# Public Turnstile widget key and server-only verification secret
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=your-production-hostname

# Server-only HMAC key; use at least 32 characters of random data
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Optional server-only cron endpoint token
CRON_SECRET_TOKEN=your-cron-token
